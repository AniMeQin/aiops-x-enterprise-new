AIOPS_AGENT_LISTEN=127.0.0.1:9188
AIOPS_CONTROL_PLANE_URL=https://control-plane.example:8443
AIOPS_REGISTRATION_TOKEN=
AIOPS_STATE_DIRECTORY=/var/lib/aiops-x
AIOPS_CA_CERT_PATH=/etc/aiops-x/agent-ca-cert.pem
AIOPS_ALLOW_INSECURE=false
AIOPS_HEARTBEAT_INTERVAL=15s
AIOPS_TASK_POLL_INTERVAL=5s
AIOPS_CERTIFICATE_RENEW_BEFORE=6h
