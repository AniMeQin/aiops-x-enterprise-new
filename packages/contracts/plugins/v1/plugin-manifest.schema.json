{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiops-x.example/contracts/plugins/v1/plugin-manifest.schema.json",
  "title": "AIOps-X Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plugin_id",
    "name",
    "version",
    "vendor",
    "description",
    "capabilities",
    "supported_asset_types",
    "configuration_schema",
    "credential_types",
    "required_permissions",
    "risk_level",
    "timeout",
    "retry_policy",
    "idempotent",
    "health_check",
    "entrypoint"
  ],
  "properties": {
    "plugin_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,119}$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 160 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][A-Za-z0-9.-]+)?$" },
    "vendor": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "capabilities": {
      "type": "array",
      "items": { "enum": ["discovery", "collector", "health_check", "action", "query", "notification"] },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 20
    },
    "supported_asset_types": { "type": "array", "items": { "type": "string" }, "maxItems": 100 },
    "configuration_schema": { "type": "object" },
    "credential_types": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
    "required_permissions": { "type": "array", "items": { "type": "string" }, "maxItems": 100 },
    "risk_level": { "enum": ["R0", "R1", "R2", "R3", "R4"] },
    "timeout": { "type": "integer", "minimum": 1, "maximum": 900 },
    "retry_policy": { "type": "object" },
    "idempotent": { "type": "boolean" },
    "health_check": { "type": "object" },
    "entrypoint": { "type": "string", "minLength": 1 }
  }
}
