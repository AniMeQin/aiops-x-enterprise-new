{
  "name": "@aiops-x/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview",
    "build": "vue-tsc -b && vite build",
    "format": "prettier --write 'src/**/*.{ts,vue,css}' '*.{ts,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,vue,css}' '*.{ts,json}'",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "axios": "1.19.0",
    "echarts": "6.1.0",
    "element-plus": "2.14.4",
    "pinia": "3.0.3",
    "vue": "3.5.41",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.2.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.6",
    "eslint": "10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  }
}
